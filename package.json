{
  "name": "upload-amazon-appstore",
  "version": "1.0",
  "private": true,
  "description": "An action to upload a signed Android release (.apk) to the Amazon Appstore",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build src/index.ts --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galonga/upload-amazon-appstore"
  },
  "keywords": [
    "actions",
    "appstore",
    "amazon"
  ],
  "author": "galonga",
  "bugs": {
    "url": "https://github.com/galonga/upload-amazon-appstore/issues"
  },
  "homepage": "https://github.com/galonga/upload-amazon-appstore#readme",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "2.0.3",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jest": "29.16.6",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
