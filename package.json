{
  "name": "upload-amazon-appstore",
  "version": "1.0",
  "private": true,
  "description": "An action to upload a signed Android release (.apk) to the Amazon Appstore",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build src/index.ts --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galonga/upload-amazon-appstore"
  },
  "keywords": [
    "actions",
    "appstore",
    "amazon"
  ],
  "author": "galonga",
  "bugs": {
    "url": "https://github.com/galonga/upload-amazon-appstore/issues"
  },
  "homepage": "https://github.com/galonga/upload-amazon-appstore#readme",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "2.0.3",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^20.8.10",
    "@typescript-eslint/parser": "^5.50.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.45.0",
    "eslint-plugin-github": "^4.7.0",
    "eslint-plugin-jest": "^27.2.3",
    "jest": "^27.2.5",
    "js-yaml": "^4.1.0",
    "prettier": "2.7.1",
    "ts-jest": "^27.1.4",
    "typescript": "^4.9.5"
  }
}
